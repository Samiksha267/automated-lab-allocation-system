# Copy this file to .env and adjust values for your machine. Never commit the
# real .env file (see .gitignore). See docs/12-DEPLOYMENT-GUIDE.md and
# docs/13-DEVELOPER-SETUP.md for how each variable is used.

# --- PostgreSQL (used by docker-compose.yml's postgres service) ------------
POSTGRES_DB=lab_allocation
POSTGRES_USER=lab_user
POSTGRES_PASSWORD=change_me

# --- Backend (Spring Boot) --------------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_NAME=lab_allocation
DB_USER=lab_user
DB_PASSWORD=change_me
SERVER_PORT=8080
# dev = demo seed accounts + verbose logging (this project's runnable-demo default).
# prod = no seed data, quieter logging, and ProductionJwtSecretGuard requires a real JWT_SECRET
# (rejects the placeholder below and anything under 32 bytes) - see docs/12-DEPLOYMENT-GUIDE.md.
SPRING_PROFILES_ACTIVE=dev
CORS_ALLOWED_ORIGINS=http://localhost:5173

# The IANA timezone the college physically operates in - used to bridge
# Allocation's LocalDate+LocalTime fields to an Instant (e.g. to compare
# against LabUnavailability's TIMESTAMPTZ range, Phase 9's HC-06). Never a
# manual UTC+offset string - see SchedulingTimeMapper (Phase 8).
COLLEGE_TIME_ZONE=Asia/Kolkata

# JWT signing secret - this example value is obviously non-production. Real
# deployments must generate a strong random secret, e.g.:
#   openssl rand -base64 48
# and set it only via a real environment variable / secrets manager - never
# commit an actual production secret to this file or anywhere else in git.
JWT_SECRET=replace_with_a_securely_generated_random_value_at_least_32_bytes_long
# Token lifetime in minutes. No refresh tokens in Phase 3 - deliberately
# simple; see docs/15-DESIGN-DECISIONS.md for the trade-off.
JWT_EXPIRATION_MINUTES=60

# --- Development-only demo accounts (dev profile ONLY - see DevUserSeeder) --
# Never set/used in production; only consumed when SPRING_PROFILES_ACTIVE=dev.
DEMO_LAB_ASSISTANT_PASSWORD=LabAssistant123!
DEMO_CR_PASSWORD=CrDemo123!
DEMO_STUDENT_PASSWORD=Student123!

# --- Frontend (Vite) ---------------------------------------------------------
# Consumed at build/dev time by the frontend API client (see frontend/src/api).
VITE_API_BASE_URL=http://localhost:8080/api
